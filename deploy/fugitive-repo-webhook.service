[Unit]
Description=GitHub webhook receiver for the Fugitive 3D server repository
Documentation=https://github.com/adnanh/webhook
After=network-online.target
Wants=network-online.target

[Service]
User=fugitive-repo
Group=fugitive-repo
Environment=HOME=/home/fugitive-repo
ExecStart=/usr/bin/webhook \
	-hooks /etc/fugitive-repo-webhook/hooks.yaml \
	-ip 127.0.0.1 \
	-port 9190 \
	-hotreload \
	-nopanic \
	-verbose
Restart=on-failure
RestartSec=5s

# NoNewPrivileges is deliberately absent, unlike the other webhook units on
# this box. A deploy here has to restart the service unit, which means
# redeploy.sh calls sudo, and NoNewPrivileges would block that. The escalation
# is bounded by /etc/sudoers.d/fugitive-repo-deploy, which permits exactly
# systemctl restart/is-active/status on fugitive-repo.service.
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/home/fugitive-repo

[Install]
WantedBy=multi-user.target
